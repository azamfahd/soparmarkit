# بقالة بلس - متغيرات البيئة
# ===================================

# المنفذ الذي يستمع عليه التطبيق
# القيمة الافتراضية: 3000
# على Railway، يتم تعيين هذا تلقائياً
PORT=3000

# قاعدة البيانات
# مسار ملف SQLite
DATABASE_PATH=grocery.db

# البيئة
# القيم المحتملة: development, production
NODE_ENV=development

# رابط API الأساسي (اختياري)
# إذا كان التطبيق يعمل على نفس الأصل، اتركه فارغاً
API_BASE=
