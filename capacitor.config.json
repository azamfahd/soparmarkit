{
  "appId": "app.azamfahd.account20.twa",
  "appName": "النظام المحاسبي الذكي",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://account20.netlify.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "account20.netlify.app",
      "smart-account20.firebaseapp.com",
      "accounts.google.com",
      "*.google.com",
      "*.googleusercontent.com",
      "*.firebaseapp.com"
    ]
  },
  "plugins": {
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "androidIsEncryption": false
    }
  }
}
